    "fine_lines": [
      {
        "title": "must vs should",
        "words": [
          "must",
          "should"
        ],
        "explanation_ar": "must تعني يجب (أمر قوي أو ضروري)، و should تعني ينبغي (نصيحة أو اقتراح). Our teacher said we must make a project. She said we should show how plants grow.",
        "explanation_en": "\"Must\" = necessary. \"Should\" = a good idea / advice.",
        "examples": [
          {
            "word": "must",
            "sentence": "We must make a project about plants."
          },
          {
            "word": "should",
            "sentence": "We should take pictures every day."
          }
        ]
      },
      {
        "title": "small vs bigger",
        "words": [
          "small",
          "bigger"
        ],
        "explanation_ar": "small صفة (صغير)، و bigger صيغة المقارنة من big (أكبر). نضاعف g ونضيف er.",
        "explanation_en": "\"Small\" is an adjective. \"Bigger\" compares: big → bigger.",
        "examples": [
          {
            "word": "small",
            "sentence": "Today the seed is small."
          },
          {
            "word": "bigger",
            "sentence": "Today the leaf is bigger."
          }
        ]
      }
    ],
    "expressions": [
      {
        "phrase": "Are you ready to talk about our project?",
        "meaning_ar": "هل أنت مستعد للحديث عن مشروعنا؟",
        "meaning_en": "Start a group discussion.",
        "example": "Are you ready to talk about our science project?"
      },
      {
        "phrase": "How do we start?",
        "meaning_ar": "كيف نبدأ؟",
        "meaning_en": "Ask about the first step.",
        "example": "We have a big project. How do we start?"
      },
      {
        "phrase": "I think we can...",
        "meaning_ar": "أظن أننا نستطيع...",
        "meaning_en": "Give an idea politely.",
        "example": "I think we can plant some seeds."
      },
      {
        "phrase": "Good idea.",
        "meaning_ar": "فكرة جيدة.",
        "meaning_en": "Agree with an idea.",
        "example": "Let's take pictures every day. Good idea."
      },
      {
        "phrase": "Who will bring the seeds?",
        "meaning_ar": "من سيُحضر البذور؟",
        "meaning_en": "Ask who will do a task.",
        "example": "Who will bring the pot?"
      },
      {
        "phrase": "I can bring...",
        "meaning_ar": "أستطيع أن أُحضر...",
        "meaning_en": "Offer to do a task.",
        "example": "I can bring the pot and the soil."
      },
      {
        "phrase": "We all have jobs now.",
        "meaning_ar": "لكلٍّ منا مهمة الآن.",
        "meaning_en": "Say the work is shared.",
        "example": "You bring seeds, I make the chart. We all have jobs now."
      },
      {
        "phrase": "Let's meet again after school tomorrow.",
        "meaning_ar": "لنلتقِ مرة أخرى بعد المدرسة غدًا.",
        "meaning_en": "Plan the next meeting.",
        "example": "Let's meet again after school tomorrow to start."
      },
      {
        "phrase": "We will do a great job!",
        "meaning_ar": "سننجز عملًا رائعًا!",
        "meaning_en": "Encourage your team.",
        "example": "Don't worry. We will do a great job!"
      }
    ],
    "grammar": [
      {
        "title": "can for ideas and offers",
        "explanation_ar": "نستخدم can + الفعل لاقتراح فكرة (We can make a chart) أو لعرض المساعدة (I can bring the seeds).",
        "explanation_en": "Use can + base verb for ideas and offers.",
        "examples": [
          "We can make a chart to show the growth.",
          "I can bring the seeds from my garden.",
          "We can also write simple notes."
        ]
      },
      {
        "title": "will for decisions and future",
        "explanation_ar": "will + الفعل لقرار نتخذه الآن أو للمستقبل: I will make the chart. Who will bring the seeds?",
        "explanation_en": "will + base verb for decisions and the future.",
        "examples": [
          "Who will bring the seeds?",
          "Great! I will make the chart.",
          "Our project will be good."
        ]
      },
      {
        "title": "Reported speech: She said we must...",
        "explanation_ar": "لننقل كلام شخص: She said (that) + الجملة: Our teacher said we must make a project.",
        "explanation_en": "To report someone's words: She said (that) + sentence.",
        "examples": [
          "Our teacher said we must make a project about plants.",
          "She said we should show how plants grow.",
          "He said he can help."
        ]
      }
    ]
  },
