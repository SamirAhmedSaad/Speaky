    "fine_lines": [
      {
        "title": "pain vs hurt",
        "words": [
          "pain",
          "hurt"
        ],
        "explanation_ar": "pain اسم (ألم): I'm in pain. و hurt فعل (يؤلم): My back hurts.",
        "explanation_en": "\"Pain\" is a noun. \"Hurt\" is a verb.",
        "examples": [
          {
            "word": "pain",
            "sentence": "I'm still in some pain."
          },
          {
            "word": "hurt",
            "sentence": "My back is still hurting."
          }
        ]
      },
      {
        "title": "medicine vs medication",
        "words": [
          "medicine",
          "medication"
        ],
        "explanation_ar": "المعنى واحد تقريبًا: دواء. medication أكثر رسمية وتُستخدم كثيرًا في المستشفيات.",
        "explanation_en": "Both mean drugs that help you get better. \"Medication\" is more formal.",
        "examples": [
          {
            "word": "medicine",
            "sentence": "Take this medicine after meals."
          },
          {
            "word": "medication",
            "sentence": "We can adjust your pain medication."
          }
        ]
      }
