    "grammar": [
      {
        "title": "Present continuous for now: How are you feeling?",
        "explanation_ar": "نستخدم المضارع المستمر لحالة الآن: How are you feeling today? I'm feeling a little better. My back is still hurting.",
        "explanation_en": "Present continuous for how you feel now.",
        "examples": [
          "How are you feeling today?",
          "I'm feeling a little better.",
          "My back is still hurting."
        ]
      },
      {
        "title": "Future: I'll / I'm going to",
        "explanation_ar": "I'll + الفعل لقرار الآن (I'll let the doctor know). و I'm going to + الفعل لخطة (I'm going to order some tests).",
        "explanation_en": "I'll = decision now; I'm going to = plan.",
        "examples": [
          "I'll let the doctor know.",
          "I'm also going to order some additional tests.",
          "We'll check in with you tomorrow."
        ]
      },
      {
        "title": "still",
        "explanation_ar": "still تعني ما زال، وتأتي قبل الفعل الرئيسي أو بعد be: My back is still hurting. I'm still in some pain.",
        "explanation_en": "\"Still\" = continuing now. It goes after be / before the main verb.",
        "examples": [
          "My back is still hurting.",
          "I'm still in some pain.",
          "They're still running some tests."
        ]
      }
    ]
  },
