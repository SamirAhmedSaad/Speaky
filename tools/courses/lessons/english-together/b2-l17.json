    "grammar": [
      {
        "title": "Plural clothes: jeans, shoes → they / them",
        "explanation_ar": "الكلمات مثل jeans وshoes وtrousers جمع دائمًا، لذا نقول they are / them.",
        "explanation_en": "Words like jeans, shoes and trousers are plural: use \"they are\" and \"them\".",
        "examples": [
          "These jeans are nice.",
          "They're too big.",
          "I will take them."
        ]
      },
      {
        "title": "Comparatives: smaller, better",
        "explanation_ar": "للمقارنة نضيف er للصفة القصيرة: small ← smaller. وgood ← better (شاذة).",
        "explanation_en": "Add -er to short adjectives: small → smaller. \"Good\" → \"better\" (irregular).",
        "examples": [
          "Do you have a smaller size?",
          "I think these are better.",
          "This pair is cheaper."
        ]
      }
    ]
