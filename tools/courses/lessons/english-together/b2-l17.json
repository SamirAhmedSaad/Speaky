    "fine_lines": [
      {
        "title": "too vs very",
        "words": [
          "too",
          "very"
        ],
        "explanation_ar": "very = جدًا (ليست مشكلة). too = أكثر من اللازم (مشكلة).",
        "explanation_en": "\"Very\" = a lot (OK). \"Too\" = more than you want (a problem).",
        "examples": [
          {
            "word": "very",
            "sentence": "These jeans are very nice."
          },
          {
            "word": "too",
            "sentence": "These jeans are too big for me."
          }
        ]
      },
      {
        "title": "How much is vs How much are",
        "words": [
          "How much is",
          "How much are"
        ],
        "explanation_ar": "مع المفرد: How much is it? مع الجمع (jeans, shoes): How much are they?",
        "explanation_en": "Singular: \"How much is it?\" Plural (jeans, shoes): \"How much are they?\"",
        "examples": [
          {
            "word": "How much is",
            "sentence": "How much is this shirt?"
          },
          {
            "word": "How much are",
            "sentence": "How much are these jeans?"
          }
        ]
      }
    ],
