    "grammar": [
      {
        "title": "Past simple questions: Where did you ...?",
        "explanation_ar": "السؤال في الماضي: did + الفاعل + الفعل الأساسي. Where did you buy it? (وليس bought).",
        "explanation_en": "Past questions: did + subject + base verb. \"Where did you buy it?\" (not \"bought\").",
        "examples": [
          "Where did you buy it?",
          "How much did it cost?",
          "Did you get anything else?"
        ]
      },
      {
        "title": "like to + verb / wear for clothes",
        "explanation_ar": "نقول I like to wear ... للحديث عن العادة. ومع الملابس والحلي والساعة نستخدم الفعل wear.",
        "explanation_en": "Say \"I like to wear ...\" for habits. Use \"wear\" with clothes, jewelry and watches.",
        "examples": [
          "I like to wear a watch.",
          "Do you like to wear earrings?",
          "I wear dresses in the summer."
        ]
      }
    ]
