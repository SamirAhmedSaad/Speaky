    "fine_lines": [
      {
        "title": "wear vs put on",
        "words": [
          "wear",
          "put on"
        ],
        "explanation_ar": "wear = يرتدي (حالة مستمرة). put on = يلبس (فعل اللبس نفسه).",
        "explanation_en": "\"Wear\" = have clothes on your body. \"Put on\" = the action of dressing.",
        "examples": [
          {
            "word": "wear",
            "sentence": "I wear a watch every day."
          },
          {
            "word": "put on",
            "sentence": "Put on your coat, it's cold."
          }
        ]
      },
      {
        "title": "buy vs get",
        "words": [
          "buy",
          "get"
        ],
        "explanation_ar": "في الكلام اليومي get تعني غالبًا buy: I got it at the mall = I bought it at the mall.",
        "explanation_en": "In everyday English, \"get\" often means \"buy\".",
        "examples": [
          {
            "word": "buy",
            "sentence": "I just bought it."
          },
          {
            "word": "get",
            "sentence": "I got it at the mall."
          }
        ]
      }
    ],
