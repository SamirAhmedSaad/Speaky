    "grammar": [
      {
        "title": "May I ...? (polite requests)",
        "explanation_ar": "May I + فعل? طريقة رسمية ومهذبة جدًا للطلب، تُستخدم كثيرًا في الفنادق.",
        "explanation_en": "\"May I + verb?\" is a very polite, formal request. Hotels use it a lot.",
        "examples": [
          "May I have your name, please?",
          "May I see your passport?",
          "May I help you?"
        ]
      },
      {
        "title": "Passive: is included / is served / will be delivered",
        "explanation_ar": "المبني للمجهول: be + التصريف الثالث، عندما يكون الشيء أهم من الفاعل.",
        "explanation_en": "Passive: be + past participle, when the thing is more important than who does it.",
        "examples": [
          "Breakfast is included.",
          "It is served from seven to ten.",
          "Your order will be delivered to your room."
        ]
      }
