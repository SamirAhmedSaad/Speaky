    "grammar": [
      {
        "title": "What's in...? / I have... / Here is...",
        "explanation_ar": "نسأل: What's in your bag? (What's = What is). ونجيب: I have cookies and nuts. أو نقدم شيئًا: Here is my water bottle.",
        "explanation_en": "Ask: What's in your bag? Answer: I have... / Here is my...",
        "examples": [
          "What's in your bag?",
          "I have cookies, some nuts, and chocolate.",
          "Here is my water bottle."
        ]
      },
      {
        "title": "some + plural / uncountable nouns",
        "explanation_ar": "نستخدم some مع الجمع (some nuts, some cookies) ومع غير المعدود (some water, some chocolate) في الجمل المثبتة.",
        "explanation_en": "Use some with plural nouns and uncountable nouns in positive sentences.",
        "examples": [
          "I have some nuts.",
          "I have some water.",
          "She has some cookies."
        ]
      },
      {
        "title": "Possessive: my + noun",
        "explanation_ar": "my تعني لي، وتأتي قبل الاسم: my umbrella, my wallet, my phone.",
        "explanation_en": "Use my before a noun to show it is yours.",
        "examples": [
          "First, my umbrella.",
          "And of course, my wallet and my phone.",
          "My bag is like my house!"
        ]
      }
    ]
