    "fine_lines": [
      {
        "title": "in vs inside",
        "words": [
          "in",
          "inside"
        ],
        "explanation_ar": "in حرف جر يأتي قبل الاسم (in my bag). inside يمكن أن تكون ظرفًا في آخر الجملة (What's inside?) أو حرف جر (inside the box).",
        "explanation_en": "\"In\" comes before a noun. \"Inside\" can end a sentence: What's inside?",
        "examples": [
          {
            "word": "in",
            "sentence": "What's in your bag?"
          },
          {
            "word": "inside",
            "sentence": "Snacks? What's inside?"
          }
        ]
      }
