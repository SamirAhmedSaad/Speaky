    "grammar": [
      {
        "title": "going to for plans",
        "explanation_ar": "نستخدم am/is/are going to + الفعل للحديث عن خطة في المستقبل.",
        "explanation_en": "Use am/is/are + going to + verb for future plans.",
        "examples": [
          "I am going to make dinner.",
          "What are you going to make?",
          "She is going to buy tomatoes."
        ]
      },
      {
        "title": "some with plural nouns",
        "explanation_ar": "نستخدم some مع الجمع وغير المعدود في الجمل المثبتة والطلبات.",
        "explanation_en": "Use \"some\" with plural and uncountable nouns in positive sentences and requests.",
        "examples": [
          "I need some carrots, please.",
          "Some tomatoes, please.",
          "I want to buy some vegetables."
        ]
      }
