    "fine_lines": [
      {
        "title": "How many vs How much",
        "words": [
          "How many",
          "How much"
        ],
        "explanation_ar": "How many مع الأشياء المعدودة (tomatoes, carrots). How much مع غير المعدودة والسعر (water, money).",
        "explanation_en": "\"How many\" for things you can count. \"How much\" for things you can't count, and for prices.",
        "examples": [
          {
            "word": "How many",
            "sentence": "How many tomatoes?"
          },
          {
            "word": "How much",
            "sentence": "How much is it?"
          }
        ]
      },
      {
        "title": "Plural -s and -es",
        "words": [
          "carrots",
          "potatoes",
          "tomatoes"
        ],
        "explanation_ar": "معظم الأسماء نضيف لها s: carrot ← carrots. الكلمات التي تنتهي بـ o مثل potato وtomato نضيف لها es.",
        "explanation_en": "Most nouns add -s. Potato and tomato add -es.",
        "examples": [
          {
            "word": "carrots",
            "sentence": "three carrots"
          },
          {
            "word": "potatoes",
            "sentence": "two potatoes"
          },
          {
            "word": "tomatoes",
            "sentence": "four tomatoes"
          }
        ]
      }
