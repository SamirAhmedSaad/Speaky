    "fine_lines": [
      {
        "title": "cook vs bake",
        "words": [
          "cook",
          "bake"
        ],
        "explanation_ar": "cook عامة: يطبخ أي طعام. bake تعني يخبز في الفرن (خبز، كعك، بسكويت).",
        "explanation_en": "Cook = make any food. Bake = cook in an oven (bread, cakes, cookies).",
        "examples": [
          {
            "word": "cook",
            "sentence": "I can cook rice and chicken."
          },
          {
            "word": "bake",
            "sentence": "I want to bake cookies."
          }
        ]
      },
      {
        "title": "run vs jog",
        "words": [
          "run",
          "jog"
        ],
        "explanation_ar": "run تعني يركض (بسرعة)، و jog تعني يهرول (ركض بطيء للرياضة).",
        "explanation_en": "Run = move fast. Jog = run slowly for exercise.",
        "examples": [
          {
            "word": "run",
            "sentence": "He runs very fast."
          },
          {
            "word": "jog",
            "sentence": "I jog in the park on Fridays."
          }
        ]
      }
    ],
    "expressions": [
      {
        "phrase": "What can I get you? Coffee or tea?",
        "meaning_ar": "ماذا أحضر لك؟ قهوة أم شاي؟",
        "meaning_en": "Offer a drink.",
        "example": "Welcome! What can I get you? Coffee or tea?"
      },
      {
        "phrase": "Coffee, please.",
        "meaning_ar": "قهوة من فضلك.",
        "meaning_en": "Choose politely.",
        "example": "Tea or juice? Juice, please."
      },
      {
        "phrase": "Any new hobbies?",
        "meaning_ar": "هل لديك هوايات جديدة؟",
        "meaning_en": "Ask about new hobbies.",
        "example": "What about you? Any new hobbies?"
      },
      {
        "phrase": "I started taking photography classes.",
        "meaning_ar": "بدأت أحضر دروسًا في التصوير.",
        "meaning_en": "Talk about something new you began.",
        "example": "I started taking swimming classes."
      },
      {
        "phrase": "What do you enjoy taking pictures of?",
        "meaning_ar": "ما الذي تستمتع بتصويره؟",
        "meaning_en": "Ask about someone's hobby.",
        "example": "What do you enjoy taking pictures of? Flowers."
      },
      {
        "phrase": "I want to see your photos.",
        "meaning_ar": "أريد أن أرى صورك.",
        "meaning_en": "Show interest.",
        "example": "You took photos of the sea? I want to see your photos."
      },
      {
        "phrase": "How often do you run?",
        "meaning_ar": "كم مرة تركض؟",
        "meaning_en": "Ask about frequency.",
        "example": "How often do you run? Three times a week."
      },
      {
        "phrase": "I should join you one day.",
        "meaning_ar": "يجب أن أنضمّ إليك يومًا ما.",
        "meaning_en": "Say you want to do it together sometime.",
        "example": "You walk every evening? I should join you one day."
      },
      {
        "phrase": "Let's go together!",
        "meaning_ar": "لنذهب معًا!",
        "meaning_en": "Suggest doing it together.",
        "example": "Let's go together on Saturday!"
      }
    ],
    "grammar": [
      {
        "title": "started + verb-ing / to + verb",
        "explanation_ar": "بعد started يمكن أن نستخدم فعلًا بـ ing أو to + الفعل: I started taking classes. I started learning to cook.",
        "explanation_en": "After \"started\" use verb-ing or to + verb.",
        "examples": [
          "I started taking photography classes.",
          "I also started learning to cook.",
          "She started to jog last month."
        ]
      },
      {
        "title": "love / enjoy + verb-ing",
        "explanation_ar": "بعد love و enjoy نستخدم الفعل مع ing: I love taking pictures. What do you enjoy taking pictures of?",
        "explanation_en": "After love and enjoy use verb-ing.",
        "examples": [
          "I love taking pictures of nature.",
          "What do you enjoy taking pictures of?",
          "I enjoy cooking with my mother."
        ]
      },
      {
        "title": "How often...? — three times a week",
        "explanation_ar": "نسأل عن عدد المرات بـ How often...? والجواب: once a week، twice a week، three times a week، sometimes.",
        "explanation_en": "Ask \"How often...?\" Answer: once / twice / three times a week.",
        "examples": [
          "How often do you run?",
          "I try to run three times a week.",
          "I jog sometimes."
        ]
      }
    ]
  },
