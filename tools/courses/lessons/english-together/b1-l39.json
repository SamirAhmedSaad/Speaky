      {
        "phrase": "Don't forget your umbrella.",
        "meaning_ar": "لا تنسَ مظلّتك.",
        "meaning_en": "Remind someone.",
        "example": "Don't forget your umbrella. It's raining."
      },
      {
        "phrase": "Drive slowly and have a safe trip.",
        "meaning_ar": "قُد ببطء وأتمنى لك رحلة آمنة.",
        "meaning_en": "Say goodbye to someone driving.",
        "example": "Drive slowly and have a safe trip!"
      },
      {
        "phrase": "See you in one hour!",
        "meaning_ar": "أراك بعد ساعة!",
        "meaning_en": "Say when you will return.",
        "example": "I'm going to the shop. See you in one hour!"
      }
    ],
    "grammar": [
      {
        "title": "Describing weather: It is + adjective / It is raining",
        "explanation_ar": "نصف الطقس بـ It is + صفة: It is cold. It is windy. ولما يحدث الآن نستخدم المضارع المستمر: It is raining.",
        "explanation_en": "Weather: It is + adjective (cold, windy). Now: It is raining.",
        "examples": [
          "It is raining outside.",
          "It is also very cold and windy.",
          "It looks very dark today."
        ]
      },
      {
        "title": "should / must for advice",
        "explanation_ar": "should + الفعل للنصيحة (You should wear a jacket)، و must + الفعل لنصيحة قوية أو ضرورة (You must be careful).",
        "explanation_en": "should = advice; must = strong advice / necessary.",
        "examples": [
          "You should wear a warm jacket.",
          "You must be careful.",
          "Then I should wear my boots too."
        ]
      },
      {
        "title": "Prepositions of place: in, on, next to",
        "explanation_ar": "in the closet (داخل الخزانة)، on the kitchen table (على طاولة المطبخ)، next to the front door (بجانب الباب الأمامي).",
        "explanation_en": "in = inside; on = on top; next to = beside.",
        "examples": [
          "I have a big jacket in the closet.",
          "Your keys are on the kitchen table.",
          "It is next to the front door."
        ]
      }
    ]
  },
