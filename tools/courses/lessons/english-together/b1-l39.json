    "expressions": [
      {
        "phrase": "What is the weather like outside?",
        "meaning_ar": "كيف الطقس في الخارج؟",
        "meaning_en": "Ask about the weather.",
        "example": "What is the weather like today? It's sunny."
      },
      {
        "phrase": "It is raining outside.",
        "meaning_ar": "إنها تمطر في الخارج.",
