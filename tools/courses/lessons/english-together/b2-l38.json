    "fine_lines": [
      {
        "title": "football (UK) vs soccer (US)",
        "words": [
          "football",
          "soccer"
        ],
        "explanation_ar": "في بريطانيا ومعظم العالم football. في أمريكا soccer، لأن football عندهم رياضة أخرى.",
        "explanation_en": "Most of the world says \"football\". Americans say \"soccer\".",
        "examples": [
          {
            "word": "football",
            "sentence": "I play football with my friends."
          },
          {
            "word": "soccer",
            "sentence": "In the US, they call it soccer."
          }
        ]
      },
      {
        "title": "watch vs play",
        "words": [
          "watch",
          "play"
        ],
        "explanation_ar": "watch = تشاهد. play = تلعب.",
        "explanation_en": "\"Watch\" = look at it. \"Play\" = do the sport.",
        "examples": [
          {
            "word": "watch",
            "sentence": "I just enjoy watching football."
          },
          {
            "word": "play",
            "sentence": "I play football on weekends."
          }
        ]
      }
    ],
    "expressions": [
      {
        "phrase": "Why are you so happy?",
        "meaning_ar": "لماذا أنت سعيد جدًا؟",
        "meaning_en": "Asking the reason for a feeling.",
        "example": "Why are you so tired?"
      },
      {
        "phrase": "Do you like football? / Yes, I love football.",
        "meaning_ar": "هل تحب كرة القدم؟ / نعم، أحبها كثيرًا.",
        "meaning_en": "Asking about likes.",
        "example": "Do you like tennis?"
      },
      {
        "phrase": "It's my favorite sport.",
        "meaning_ar": "إنها رياضتي المفضلة.",
        "meaning_en": "Saying what you like most.",
        "example": "Swimming is my favorite sport."
      },
      {
        "phrase": "Which team do you support?",
        "meaning_ar": "أي فريق تشجع؟",
        "meaning_en": "Asking about a team.",
        "example": "Which team do you support? I support Brazil."
      },
      {
        "phrase": "They play very well.",
        "meaning_ar": "إنهم يلعبون جيدًا جدًا.",
        "meaning_en": "Praising a team.",
        "example": "Our team plays very well this year."
      },
      {
        "phrase": "That sounds like fun.",
        "meaning_ar": "يبدو ذلك ممتعًا.",
        "meaning_en": "Saying something is enjoyable.",
        "example": "Watching with friends? That sounds like fun."
      },
      {
        "phrase": "Who is your favorite player?",
        "meaning_ar": "من لاعبك المفضل؟",
        "meaning_en": "Asking about a player.",
        "example": "Who is your favorite player? Mohamed Salah."
      },
      {
        "phrase": "What time is the match today?",
        "meaning_ar": "متى المباراة اليوم؟",
        "meaning_en": "Asking the time.",
        "example": "What time is the match? It starts at eight."
      },
      {
        "phrase": "Why don't we watch the match together tonight?",
        "meaning_ar": "لماذا لا نشاهد المباراة معًا الليلة؟",
        "meaning_en": "A suggestion.",
        "example": "Why don't we play together on Friday?"
      },
      {
        "phrase": "That's a great idea!",
        "meaning_ar": "هذه فكرة رائعة!",
        "meaning_en": "Agreeing.",
        "example": "Pizza? That's a great idea!"
      }
    ],
    "grammar": [
      {
        "title": "Adverbs of frequency: usually, every day",
        "explanation_ar": "نقول كم مرة نفعل شيئًا: I usually watch at a cafe. I watch the matches every day.",
        "explanation_en": "Say how often: \"usually\" before the verb; \"every day / on weekends\" at the end.",
        "examples": [
          "I usually watch them at a cafe.",
          "I watch the matches every day.",
          "I play on weekends."
        ]
      },
      {
        "title": "Present simple: do / don't / does",
        "explanation_ar": "للسؤال: Do you like ...? للنفي: I don't play. مع he/she: Does she play?",
        "explanation_en": "Questions: \"Do you ...?\" Negative: \"I don't ...\". With he/she: \"Does she ...?\"",
        "examples": [
          "Do you play football too?",
          "I don't play football.",
          "Does your brother like football?"
        ]
      }
    ]
  },
