    "fine_lines": [
      {
        "title": "expensive vs cheap",
        "words": [
          "expensive",
          "cheap"
        ],
        "explanation_ar": "expensive = غالٍ. cheap = رخيص. للمقارنة: more expensive / cheaper.",
        "explanation_en": "\"Expensive\" = costs a lot. \"Cheap\" = costs little. Comparative: more expensive / cheaper.",
        "examples": [
          {
            "word": "expensive",
            "sentence": "It's a bit more expensive."
          },
          {
            "word": "cheap",
            "sentence": "This one is cheaper."
          }
        ]
      },
      {
        "title": "stick with vs go for",
        "words": [
          "stick with",
          "go for"
        ],
        "explanation_ar": "stick with = تبقى على اختيارك الأول. go for = تختار شيئًا.",
        "explanation_en": "\"Stick with\" = keep your first choice. \"Go for\" = choose.",
        "examples": [
          {
            "word": "stick with",
            "sentence": "I'll stick with the first one."
          },
          {
            "word": "go for",
            "sentence": "I'll go for the bigger one."
          }
        ]
      }
    ],
    "expressions": [
      {
        "phrase": "What can I help you with?",
        "meaning_ar": "بماذا يمكنني مساعدتك؟",
        "meaning_en": "The shopkeeper offers help.",
        "example": "Hi! What can I help you with today?"
      },
      {
        "phrase": "I need a new computer for school.",
        "meaning_ar": "أحتاج حاسوبًا جديدًا للمدرسة.",
        "meaning_en": "Saying what you need.",
        "example": "I need a new phone for work."
      },
      {
        "phrase": "What's your budget like?",
        "meaning_ar": "كم ميزانيتك؟",
        "meaning_en": "Asking how much you can spend.",
        "example": "Before we start, what's your budget like?"
      },
      {
        "phrase": "I don't want to spend too much.",
        "meaning_ar": "لا أريد أن أنفق كثيرًا.",
        "meaning_en": "You want a low price.",
        "example": "I don't want to spend too much on shoes."
      },
      {
        "phrase": "Let me show you what we have.",
        "meaning_ar": "دعني أريك ما لدينا.",
        "meaning_en": "The seller offers to show products.",
        "example": "Let me show you our new phones."
      },
      {
        "phrase": "Can I see it and try it out?",
        "meaning_ar": "هل يمكنني رؤيته وتجربته؟",
        "meaning_en": "Asking to test something.",
        "example": "Can I try this phone out?"
      },
      {
        "phrase": "Do you have any other options?",
        "meaning_ar": "هل لديكم خيارات أخرى؟",
        "meaning_en": "Asking for more choices.",
        "example": "I'm not sure. Do you have any other options?"
      },
      {
        "phrase": "I think I'll stick with the first one.",
        "meaning_ar": "أظن أنني سأبقى على الأول.",
        "meaning_en": "Keeping your first choice.",
        "example": "They're both nice, but I'll stick with the first one."
      },
      {
        "phrase": "Do you need any accessories?",
        "meaning_ar": "هل تحتاج أي ملحقات؟",
        "meaning_en": "Offering extra things.",
        "example": "Do you need a case for your phone?"
      },
      {
        "phrase": "Good luck with your studies!",
        "meaning_ar": "بالتوفيق في دراستك!",
        "meaning_en": "A kind wish to a student.",
        "example": "Good luck with your exams!"
      },
      {
        "phrase": "Thank you, I appreciate it.",
        "meaning_ar": "شكرًا، أقدّر ذلك.",
        "meaning_en": "A polite thank you.",
        "example": "Thanks for your help. I appreciate it."
      }
    ],
    "grammar": [
      {
        "title": "Comparatives: larger, more expensive",
        "explanation_ar": "للصفات القصيرة نضيف er (larger)، وللطويلة نستخدم more (more expensive). ونقارن بـ than.",
        "explanation_en": "Short adjectives + -er (larger). Long adjectives: more + adjective (more expensive). Use \"than\".",
        "examples": [
          "It has a larger hard drive.",
          "It's a bit more expensive.",
          "This laptop is lighter than that one."
        ]
      },
      {
        "title": "will for offers: I'll grab it / I'll add it",
        "explanation_ar": "نستخدم I'll + فعل عندما نعرض أن نفعل شيئًا الآن.",
        "explanation_en": "Use \"I'll + verb\" to offer to do something now.",
        "examples": [
          "I'll grab that for you.",
          "I'll add that to your purchase.",
          "I'll take a mouse."
        ]
      }
    ]
  },
