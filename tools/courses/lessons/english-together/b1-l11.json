    "grammar": [
      {
        "title": "Present simple: I / my mother",
        "explanation_ar": "نستخدم المضارع البسيط للعادات اليومية. مع I الفعل في أصله: I go, I eat. ومع he/she/my mother نضيف s: My mother cooks soup.",
        "explanation_en": "Present simple for habits. With I: base verb. With he/she: add -s (my mother cooks).",
        "examples": [
          "I go to school on foot.",
          "I have lunch at school.",
          "My mother always cooks soup for dinner."
        ]
      },
      {
        "title": "Negative: do not + verb",
        "explanation_ar": "للنفي في المضارع البسيط مع I/you/we/they نستخدم do not (don't) + الفعل في أصله: I do not go to school by bus.",
        "explanation_en": "Negative: do not (don't) + base verb.",
        "examples": [
          "I do not go to school by bus.",
          "I don't eat breakfast late.",
          "We don't play outside at night."
        ]
      },
      {
        "title": "Telling the time: at + time",
        "explanation_ar": "نستخدم at مع الساعات: at 8 a.m.، at 7 o'clock.",
        "explanation_en": "Use \"at\" with clock times: at 8 a.m.",
        "examples": [
          "I wake up at 8 a.m.",
          "I go to bed at 9 o'clock.",
          "Lunch is at 12."
        ]
      }
    ]
