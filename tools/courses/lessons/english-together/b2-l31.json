      {
        "title": "take off vs land",
        "words": [
          "take off",
          "land"
        ],
        "explanation_ar": "take off = تُقلع الطائرة (تبدأ الطيران). land = تهبط (تنزل على الأرض).",
        "explanation_en": "\"Take off\" = start flying. \"Land\" = come down to the ground.",
        "examples": [
          {
            "word": "take off",
            "sentence": "We will take off soon."
          },
          {
            "word": "land",
            "sentence": "We are ready to land."
          }
        ]
      },
      {
        "title": "Here you are vs Here is",
        "words": [
          "Here you are",
          "Here is"
