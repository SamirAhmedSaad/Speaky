    "grammar": [
      {
        "title": "Polite choices: Would you like A or B?",
        "explanation_ar": "نعرض خيارين: Would you like + A + or + B? والجواب: I'll have ... / I'll take ...",
        "explanation_en": "Offer two choices: \"Would you like A or B?\" Answer: \"I'll have ...\" / \"I'll take ...\".",
        "examples": [
          "Would you like the chicken or the fish?",
          "I'll have the fish, please.",
          "Would you like tea or coffee?"
        ]
      },
      {
        "title": "Present continuous for now: We are serving lunch",
        "explanation_ar": "نستخدم am/is/are + ing لما يحدث الآن.",
        "explanation_en": "Use am/is/are + -ing for what is happening now.",
        "examples": [
          "We are serving lunch now.",
          "We are flying over the sea.",
          "She is reading her book."
        ]
      }
