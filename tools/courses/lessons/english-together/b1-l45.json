    "grammar": [
      {
        "title": "Comparatives: -er / more + than",
        "explanation_ar": "للمقارنة بين شيئين: صفة قصيرة + er + than (cheaper than)، أو more + صفة طويلة + than (more colorful than). والصفة المنتهية بـ y تتحول إلى ier (healthier).",
        "explanation_en": "Compare two things: short adjective + -er + than; more + long adjective + than; -y → -ier.",
        "examples": [
          "Green apples are cheaper than the red ones.",
          "Bell peppers are more colorful than carrots.",
          "Whole grain bread is healthier than white bread."
        ]
      },
      {
        "title": "Superlatives: the -est / the most",
        "explanation_ar": "لأعلى درجة في مجموعة: the + صفة قصيرة + est (the biggest)، أو the most + صفة طويلة (the most impressive).",
        "explanation_en": "The top of a group: the + -est (the biggest) or the most + long adjective.",
        "examples": [
          "Those bigger ones are the most impressive.",
          "They must be the biggest pumpkins I've ever seen.",
          "Let's get the biggest one."
        ]
      },
      {
        "title": "Suggestions: Let's... / How about...?",
        "explanation_ar": "للاقتراح: Let's + الفعل (Let's get some of both)، أو How about + اسم؟ (How about apples?)",
        "explanation_en": "Suggestions: Let's + verb / How about + noun?",
        "examples": [
          "How about apples?",
          "Let's get some of both.",
          "How about some bread for sandwiches?"
        ]
      }
    ]
  },
