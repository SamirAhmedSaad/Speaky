    "fine_lines": [
      {
        "title": "cheaper vs cheapest",
        "words": [
          "cheaper",
          "cheapest"
        ],
        "explanation_ar": "صيغة المقارنة (er + than) لمقارنة شيئين: Green apples are cheaper than red ones. وصيغة التفضيل (the + est) لأكثر شيء بين ثلاثة أو أكثر: the cheapest.",
        "explanation_en": "Comparative (-er + than) compares two things. Superlative (the -est) is the top of a group.",
        "examples": [
          {
            "word": "cheaper",
            "sentence": "Green apples are cheaper than red apples."
          },
          {
            "word": "cheapest",
            "sentence": "These are the cheapest apples in the market."
          }
        ]
      },
      {
        "title": "more + adjective vs -er",
        "words": [
          "more colorful",
          "sweeter"
        ],
        "explanation_ar": "الصفات القصيرة (مقطع واحد) نضيف لها er: sweet → sweeter. الصفات الطويلة نضع قبلها more: colorful → more colorful. والصفة المنتهية بـ y: healthy → healthier.",
        "explanation_en": "Short adjectives: -er (sweeter). Long adjectives: more + adjective (more colorful). -y → -ier (healthier).",
        "examples": [
          {
            "word": "more colorful",
            "sentence": "Bell peppers are more colorful than carrots."
          },
          {
            "word": "sweeter",
            "sentence": "Red apples are sweeter than green apples."
          }
        ]
      },
      {
        "title": "big → bigger → the biggest",
        "words": [
          "bigger",
          "biggest"
        ],
        "explanation_ar": "إذا انتهت الصفة بحرف ساكن بعد حرف علة واحد نضاعف الحرف الأخير: big → bigger → the biggest.",
        "explanation_en": "One vowel + one consonant: double the consonant: big → bigger → the biggest.",
        "examples": [
          {
            "word": "bigger",
            "sentence": "Those bigger ones are the most impressive."
          },
          {
            "word": "biggest",
            "sentence": "Let's get the biggest one."
          }
        ]
      }
    ],
