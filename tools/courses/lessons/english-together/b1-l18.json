    "fine_lines": [
      {
        "title": "store vs mall",
        "words": [
          "store",
          "mall"
        ],
        "explanation_ar": "store متجر واحد، و mall مبنى كبير فيه متاجر كثيرة.",
        "explanation_en": "A store is one shop. A mall is a big building with many stores.",
        "examples": [
          {
            "word": "store",
            "sentence": "I went to a shoe store."
          },
          {
            "word": "mall",
            "sentence": "The mall has fifty stores."
          }
        ]
      },
      {
        "title": "bought vs got",
        "words": [
          "bought",
          "got"
        ],
        "explanation_ar": "bought ماضي buy (اشترى). got ماضي get، وفي الكلام اليومي يعني أيضًا اشترى أو حصل على.",
        "explanation_en": "\"Bought\" is the past of buy. \"Got\" (past of get) can also mean bought in everyday English.",
        "examples": [
          {
            "word": "bought",
            "sentence": "I bought a sweater."
          },
          {
            "word": "got",
            "sentence": "I also got a new pair of sneakers."
          }
        ]
      }
    ],
    "expressions": [
      {
        "phrase": "How was your day yesterday?",
        "meaning_ar": "كيف كان يومك أمس؟",
        "meaning_en": "Ask about someone's past day.",
