    ],
    "grammar": [
      {
        "title": "Past simple questions with \"did\"",
        "explanation_ar": "نسأل عن الماضي بـ What/Where + did + الفاعل + الفعل في أصله: What did you buy? What did you do at the mall? والجواب بالماضي: I bought a sweater.",
        "explanation_en": "Past questions: Wh-word + did + subject + base verb. Answer with the past form.",
        "examples": [
          "What did you do at the mall?",
          "What did you buy at the clothing store?",
          "What book did you get?"
        ]
      },
      {
        "title": "Irregular past verbs",
        "explanation_ar": "أفعال شاذة في الدرس: go → went، buy → bought، get → got، find → found، think → thought، have → had، be → was.",
        "explanation_en": "Irregular verbs here: went, bought, got, found, thought, had, was.",
        "examples": [
          "I went shopping with my mom.",
          "I bought a really nice sweater.",
          "I found a really interesting book."
        ]
      },
      {
        "title": "How was...? — It was...",
        "explanation_ar": "لنسأل عن رأي في شيء مضى: How was your day? والجواب: It was a really nice day.",
        "explanation_en": "Ask about a past experience: How was...? Answer: It was...",
        "examples": [
          "How was your day yesterday?",
          "It was a really nice day!",
          "How was the trip? It was fun."
        ]
      }
    ]
  },
