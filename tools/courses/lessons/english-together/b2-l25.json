    "grammar": [
      {
        "title": "How long / How many / How much",
        "explanation_ar": "How long للمدة، How many للعدد المعدود، How much للسعر أو غير المعدود.",
        "explanation_en": "\"How long\" = time. \"How many\" = number. \"How much\" = price or uncountable amount.",
        "examples": [
          "How long is express?",
          "How many stamps do you need?",
          "How much is the delivery charge?"
        ]
      },
      {
        "title": "Present perfect: I've finished",
        "explanation_ar": "I've finished تعني انتهيت الآن للتو (have + التصريف الثالث).",
        "explanation_en": "\"I've finished\" = I am done now (have + past participle).",
        "examples": [
          "I've finished.",
          "I've written the address.",
          "She has sent the package."
        ]
      }
    ]
