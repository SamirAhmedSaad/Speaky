    "fine_lines": [
      {
        "title": "express vs regular",
        "words": [
          "express",
          "regular"
        ],
        "explanation_ar": "express = سريع وأغلى. regular = عادي وأبطأ وأرخص.",
        "explanation_en": "\"Express\" is fast and costs more. \"Regular\" is slower and cheaper.",
        "examples": [
          {
            "word": "express",
            "sentence": "Express is overnight."
          },
          {
            "word": "regular",
            "sentence": "Regular takes two to three days."
          }
        ]
      },
      {
        "title": "destination vs return address",
        "words": [
          "destination",
          "return address"
        ],
        "explanation_ar": "destination = المكان الذي سيذهب إليه الطرد. return address = عنوانك أنت (المرسل).",
        "explanation_en": "\"Destination\" = where it goes. \"Return address\" = your address (the sender).",
        "examples": [
          {
            "word": "destination",
            "sentence": "The destination is Los Angeles."
          },
          {
            "word": "return address",
            "sentence": "Write your return address in the corner."
          }
        ]
      }
    ],
