    "grammar": [
      {
        "title": "any in questions, some in answers",
        "explanation_ar": "نستخدم any في الأسئلة والنفي، وsome في الإثبات: Do you have any cheese? Yes, I have some.",
        "explanation_en": "Use \"any\" in questions and negatives, \"some\" in positive sentences.",
        "examples": [
          "Do you have any cheese?",
          "I'll take some sliced turkey.",
          "We don't have any milk."
        ]
      },
      {
        "title": "Passive: It was baked this morning",
        "explanation_ar": "المبني للمجهول في الماضي: was/were + التصريف الثالث. نستخدمه عندما لا يهم من فعل الشيء.",
        "explanation_en": "Past passive: was/were + past participle. Use it when who did it is not important.",
        "examples": [
          "It was baked this morning.",
          "The bread was made today.",
          "The fish was caught yesterday."
        ]
      }
