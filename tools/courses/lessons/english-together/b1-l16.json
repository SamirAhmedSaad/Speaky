    "grammar": [
      {
        "title": "Present continuous: am / is / are + verb-ing",
        "explanation_ar": "نستخدم المضارع المستمر لما يحدث الآن: I am (I'm) cooking. She is (She's) fixing. They are (They're) talking. والسؤال: What are you doing?",
        "explanation_en": "For actions happening now: am/is/are + verb-ing. Question: What are you doing?",
        "examples": [
          "What are you doing?",
          "I'm making spaghetti and meatballs.",
          "I'm replacing the spark plugs."
        ]
      },
      {
        "title": "Spelling of -ing",
        "explanation_ar": "أغلب الأفعال نضيف لها ing: cook → cooking. إذا انتهى الفعل بـ e صامتة نحذفها: make → making، practice → practicing. وبعض الأفعال القصيرة نضاعف الحرف الأخير: stop → stopping.",
        "explanation_en": "Most verbs: add -ing. Drop silent e: make → making. Some short verbs double the last letter: stop → stopping.",
        "examples": [
          "cook → cooking",
          "make → making",
          "boil → boiling"
        ]
      },
      {
        "title": "Negative commands: Don't + verb",
        "explanation_ar": "للنهي نستخدم Don't + الفعل في أصله: Don't burn the meatballs! Don't worry.",
        "explanation_en": "Use Don't + base verb to tell someone not to do something.",
        "examples": [
          "Don't burn the meatballs!",
          "Don't worry, Sarah.",
          "Don't forget the salt."
        ]
      }
    ]
  },
