    "fine_lines": [
      {
        "title": "Present simple vs present continuous",
        "words": [
          "I cook",
          "I'm cooking"
        ],
        "explanation_ar": "المضارع البسيط للعادات (I cook dinner every day). المضارع المستمر لما يحدث الآن (I'm cooking dinner now).",
        "explanation_en": "Present simple = habits. Present continuous = happening now.",
        "examples": [
          {
            "word": "I cook",
            "sentence": "I cook dinner every evening."
          },
          {
            "word": "I'm cooking",
            "sentence": "Shh! I'm cooking dinner now."
          }
        ]
      }
    ],
