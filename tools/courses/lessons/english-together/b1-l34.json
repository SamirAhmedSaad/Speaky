    "grammar": [
      {
        "title": "Present perfect: Have you packed everything?",
        "explanation_ar": "نسأل هل أنجزنا شيئًا بـ Have you + التصريف الثالث: Have you packed everything? I have printed it out.",
        "explanation_en": "Have you + past participle asks if something is done.",
        "examples": [
          "Have you packed everything?",
          "I have printed it out.",
          "It's been good."
        ]
      },
      {
        "title": "Future: will and be going to",
        "explanation_ar": "will لتوقّع أو وعد (You'll love it. Everything will be okay)، و be going to لخطة (I'm going to take photography).",
        "explanation_en": "Will for predictions and promises; going to for plans.",
        "examples": [
          "Everything will be okay.",
          "You'll love it.",
          "I'm going to take photography."
        ]
      },
      {
        "title": "or for a warning",
        "explanation_ar": "نستخدم أمرًا + or + نتيجة: Hurry up or you'll be late! أي إذا لم تُسرع ستتأخر.",
        "explanation_en": "Command + or + result: Hurry up or you'll be late.",
        "examples": [
          "Hurry up or you'll be late!",
          "Study or you'll fail the test.",
          "Take a coat or you'll be cold."
        ]
      }
    ]
