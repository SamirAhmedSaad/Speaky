    "fine_lines": [
      {
        "title": "nervous vs excited",
        "words": [
          "nervous",
          "excited"
        ],
        "explanation_ar": "nervous متوتّر وقلق قليلًا، و excited متحمّس وسعيد. يمكن أن نشعر بالاثنين معًا في اليوم الأول.",
        "explanation_en": "Nervous = a little worried. Excited = very happy. You can feel both on a first day.",
        "examples": [
          {
            "word": "nervous",
            "sentence": "I'm kind of nervous."
          },
          {
            "word": "excited",
            "sentence": "I'm pretty excited and nervous."
          }
        ]
      },
      {
        "title": "schedule vs timetable",
        "words": [
          "schedule",
          "timetable"
        ],
        "explanation_ar": "كلاهما جدول المواعيد. timetable شائعة في بريطانيا للمدرسة والقطارات، و schedule شائعة في أمريكا.",
        "explanation_en": "Both mean a list of times. Timetable is common in British English; schedule in American English.",
        "examples": [
          {
            "word": "schedule",
            "sentence": "You need the schedule to find your classes."
          },
          {
            "word": "timetable",
            "sentence": "Let me see your timetable."
          }
        ]
      }
    ],
