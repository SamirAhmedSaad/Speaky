      {
        "title": "tight vs loose",
        "words": [
          "tight",
          "loose"
        ],
        "explanation_ar": "tight = ضيق جدًا. loose = واسع وفضفاض.",
        "explanation_en": "\"Tight\" = too small, pressing. \"Loose\" = too big, not close to your body.",
        "examples": [
          {
            "word": "tight",
            "sentence": "These shoes feel tight."
          },
          {
            "word": "loose",
            "sentence": "My belt is loose."
          }
        ]
      },
      {
        "title": "feel vs look",
        "words": [
