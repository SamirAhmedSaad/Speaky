    "grammar": [
      {
        "title": "Frequency: every month, once a week, often",
        "explanation_ar": "نعبّر عن عدد المرات بـ: every day / every month، once a week، often، not often.",
        "explanation_en": "Say how often: every day/month, once a week, often, not often.",
