    "fine_lines": [
      {
        "title": "spend vs save",
        "words": [
          "spend",
          "save"
        ],
        "explanation_ar": "spend = تُنفق المال. save = تحتفظ بالمال ولا تُنفقه.",
        "explanation_en": "\"Spend\" = use money. \"Save\" = keep money.",
        "examples": [
          {
            "word": "spend",
            "sentence": "I spend $40 on entertainment."
          },
          {
            "word": "save",
            "sentence": "I save $100 every month."
          }
        ]
      },
      {
        "title": "a lot vs not too much",
        "words": [
          "a lot",
          "not too much"
        ],
        "explanation_ar": "a lot = كثير. not too much = ليس كثيرًا.",
        "explanation_en": "\"A lot\" = a big amount. \"Not too much\" = only a little.",
        "examples": [
          {
            "word": "a lot",
            "sentence": "Rent costs a lot."
          },
          {
            "word": "not too much",
            "sentence": "I don't spend too much on food."
          }
        ]
      }
    ],
    "expressions": [
