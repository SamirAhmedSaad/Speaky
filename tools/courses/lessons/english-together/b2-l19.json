    "grammar": [
      {
        "title": "Present simple: likes / does ... like?",
        "explanation_ar": "مع he / she / it نضيف s للفعل: She likes books. وفي السؤال: What does she like? (بدون s).",
        "explanation_en": "With he/she/it, add -s: \"She likes\". Question: \"What does she like?\" (no -s).",
        "examples": [
          "She likes books and flowers.",
          "What does your friend like?",
          "Does she like roses?"
        ]
      },
      {
        "title": "Short answers: Yes, I do / Yes, it is",
        "explanation_ar": "نجيب باختصار بنفس الفعل المساعد: Do you ...? Yes, I do. / Is it ...? Yes, it is.",
        "explanation_en": "Answer with the same helping verb: \"Do you ...? Yes, I do.\" \"Is it ...? Yes, it is.\"",
        "examples": [
          "Do you want to buy it? Yes, I do.",
          "Is it beautiful? Yes, it is.",
          "Can you help? Yes, I can."
        ]
      }
    ]
