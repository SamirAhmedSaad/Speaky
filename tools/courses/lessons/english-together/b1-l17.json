    "fine_lines": [
      {
        "title": "Regular vs irregular past verbs",
        "words": [
          "played",
          "went"
        ],
        "explanation_ar": "الأفعال المنتظمة يضاف لها ed في الماضي: play → played، watch → watched. الأفعال الشاذة لها شكل خاص: go → went، buy → bought، have → had، win → won، do → did.",
        "explanation_en": "Regular verbs add -ed (played, watched). Irregular verbs change (went, bought, had, won, did).",
        "examples": [
          {
            "word": "played",
            "sentence": "I played tennis with Tom."
          },
          {
            "word": "went",
            "sentence": "I went to the park."
          }
        ]
      }
    ],
    "expressions": [
      {
        "phrase": "What did you do yesterday?",
        "meaning_ar": "ماذا فعلت أمس؟",
        "meaning_en": "Ask about someone's past day.",
        "example": "What did you do yesterday? I went shopping."
      },
      {
        "phrase": "I did many things.",
        "meaning_ar": "فعلت أشياء كثيرة.",
        "meaning_en": "Say you were busy.",
        "example": "Yesterday I did many things."
      },
      {
        "phrase": "What else did you do?",
        "meaning_ar": "ماذا فعلت أيضًا؟",
        "meaning_en": "Ask for more information.",
        "example": "You went shopping. What else did you do?"
      },
      {
        "phrase": "Who did you play with?",
        "meaning_ar": "مع من لعبت؟",
        "meaning_en": "Ask about the people with you.",
        "example": "Who did you play with? I played with Tom."
      },
      {
        "phrase": "Did you win? — Yes, I won!",
        "meaning_ar": "هل فزت؟ — نعم، فزت!",
        "meaning_en": "Ask about a game result.",
        "example": "Did you win? Yes, I won!"
      },
      {
        "phrase": "Did you go alone?",
        "meaning_ar": "هل ذهبت وحدك؟",
        "meaning_en": "Ask if someone was with you.",
        "example": "Did you go alone? No, I went with John."
      },
      {
        "phrase": "Which flavor did you have?",
        "meaning_ar": "أي نكهة أخذت؟",
        "meaning_en": "Ask about choice of ice cream or food.",
        "example": "Which flavor did you have? Chocolate."
      },
      {
        "phrase": "What was it about?",
        "meaning_ar": "عمّ كان؟",
        "meaning_en": "Ask about the story of a film or book.",
        "example": "I read a book. What was it about?"
      },
      {
        "phrase": "That sounds interesting.",
        "meaning_ar": "يبدو هذا مثيرًا للاهتمام.",
        "meaning_en": "Show interest.",
        "example": "A movie about space? That sounds interesting."
      }
    ],
    "grammar": [
      {
        "title": "Past simple questions: What did you...? / Did you...?",
        "explanation_ar": "نسأل في الماضي بـ did + الفاعل + الفعل في أصله: What did you do? Did you win? والجواب القصير: Yes, I did. / No, I didn't. ولا نقول Did you won.",
        "explanation_en": "Past questions: did + subject + base verb. Short answer: Yes, I did / No, I didn't.",
        "examples": [
          "What did you buy?",
          "Did you watch the movie last night? Yes, I did.",
          "Who did you watch it with?"
        ]
      },
      {
        "title": "Past simple: positive sentences",
        "explanation_ar": "في الجملة المثبتة نستخدم الفعل في الماضي: I played tennis. I went to the park. I bought new clothes. It was a sunny day.",
        "explanation_en": "In positive sentences use the past form: played, went, bought, was.",
        "examples": [
          "I went shopping.",
          "I bought new clothes.",
          "It was amazing!"
        ]
      },
      {
        "title": "was / were",
        "explanation_ar": "was مع I/he/she/it، و were مع you/we/they: It was a sunny day. We were at the park.",
        "explanation_en": "was with I/he/she/it; were with you/we/they.",
        "examples": [
          "It was a sunny day.",
          "It was a movie about space travel.",
          "We were very happy."
        ]
      }
    ]
  },
