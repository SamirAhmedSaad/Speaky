      {
        "phrase": "You'll be a pro soon.",
        "meaning_ar": "ستصبح محترفًا قريبًا.",
        "meaning_en": "Encouraging someone.",
        "example": "Keep practising. You'll be a pro soon."
      }
    ],
    "grammar": [
      {
        "title": "must have + past participle",
        "explanation_ar": "نستخدم must have + التصريف الثالث لتخمين قوي عن شيء في الماضي.",
        "explanation_en": "Use \"must have + past participle\" for a strong guess about the past.",
        "examples": [
          "It must have been an awesome trip.",
          "You must have been tired.",
          "She must have seen the news."
        ]
      },
      {
        "title": "Present perfect continuous: Work's been crazy",
        "explanation_ar": "Work's been = Work has been: لحالة بدأت في الماضي ومستمرة حتى الآن.",
        "explanation_en": "\"Work's been\" = \"Work has been\": a situation from the past until now.",
        "examples": [
          "Work's been crazy.",
          "I've been busy.",
          "It has been a long week."
        ]
      }
    ]
  },
