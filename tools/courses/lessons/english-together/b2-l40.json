    "fine_lines": [
      {
        "title": "It was vs It must have been",
        "words": [
          "It was",
          "It must have been"
        ],
        "explanation_ar": "It was = تقول ما حدث فعلًا. It must have been = تخمين قوي عن الماضي (أنا متأكد تقريبًا).",
        "explanation_en": "\"It was\" = a fact. \"It must have been\" = a strong guess about the past.",
        "examples": [
          {
            "word": "It was",
            "sentence": "It was amazing!"
          },
          {
            "word": "It must have been",
            "sentence": "It must have been an awesome trip."
          }
        ]
      },
      {
        "title": "How was it? vs What was it?",
        "words": [
          "How was it",
          "What was it"
        ],
        "explanation_ar": "How was it? تسأل عن رأيه أو تجربته. What was it? تسأل ما هو الشيء.",
        "explanation_en": "\"How was it?\" asks about the experience. \"What was it?\" asks what the thing was.",
        "examples": [
          {
            "word": "How was it",
            "sentence": "How was your trip? It was amazing."
          },
          {
            "word": "What was it",
            "sentence": "What was that noise?"
          }
        ]
      }
    ],
    "expressions": [
      {
