    "grammar": [
      {
        "title": "Present simple with frequency: usually, sometimes, once a week",
        "explanation_ar": "نستخدم المضارع البسيط مع كلمات التكرار للعادات: I usually eat fast food. Sometimes I eat oatmeal. Maybe once a week.",
        "explanation_en": "Present simple + frequency words for habits.",
        "examples": [
          "I usually eat fast food.",
          "Sometimes I eat oatmeal.",
          "I run here three times a week."
        ]
      },
      {
        "title": "make / give / help + someone",
        "explanation_ar": "Exercise makes my heart strong (make + اسم + صفة). Healthy food gives me energy (give + شخص + شيء). It helps my muscles.",
        "explanation_en": "make + object + adjective; give + person + thing; help + object.",
        "examples": [
          "Exercise makes my heart strong.",
          "Healthy food gives me energy.",
          "Running helps my muscles."
        ]
      },
      {
        "title": "Comparatives: healthier",
        "explanation_ar": "لنقارن: صفة قصيرة + er (strong → stronger). وإذا انتهت بـ y نحولها إلى i: healthy → healthier.",
        "explanation_en": "Comparatives: add -er; y → i: healthier.",
        "examples": [
          "I want to be healthier.",
          "Exercise makes you stronger.",
          "Walking is easier than running."
        ]
      }
    ]
