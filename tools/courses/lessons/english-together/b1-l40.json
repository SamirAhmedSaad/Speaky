        "title": "walk vs jog vs run",
        "words": [
          "walk",
          "jog",
          "run"
        ],
        "explanation_ar": "walk يمشي، jog يهرول (ركض بطيء)، run يركض بسرعة.",
        "explanation_en": "Walk (slow), jog (slow running), run (fast).",
        "examples": [
          {
            "word": "walk",
            "sentence": "First, we will walk."
          },
          {
            "word": "jog",
            "sentence": "Then we will jog a little."
          },
          {
            "word": "run",
            "sentence": "I run in the park every morning."
          }
        ]
