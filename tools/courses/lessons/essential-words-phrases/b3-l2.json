    "grammar": [
      {
        "title": "A has three main sounds",
        "explanation_ar": "الحرف a: /æ/ كما في apple و cat؛ و/eɪ/ مثل اسمه كما في date و game؛ و/ɔː/ عندما يأتي بعده l أو w كما في ball و saw.",
        "explanation_en": "A: /æ/ as in apple, cat; /eɪ/ like its name as in date, game; /ɔː/ before l or w as in ball, saw.",
        "examples": [
          "cat /æ/",
          "date /eɪ/",
          "ball /ɔː/"
        ]
      },
      {
        "title": "Soft C: /s/ before e, i, y",
        "explanation_ar": "الحرف c ينطق /k/ في أغلب الكلمات (cake, cup). لكن إذا جاء بعده e أو i أو y ينطق /s/ (city, cycle, cent).",
        "explanation_en": "C is usually /k/ (cake, cup). Before e, i or y it sounds /s/ (city, cycle, cent).",
        "examples": [
          "cup /k/",
          "city /s/",
          "cycle /s/ ... /k/"
        ]
      },
      {
        "title": "Soft G: /dʒ/ before e, i, y",
        "explanation_ar": "الحرف g ينطق /ɡ/ غالباً (go, gift). وقبل e أو i أو y ينطق /dʒ/ (giraffe, gym, geography). هناك استثناءات مثل give و get تُتعلم بالممارسة.",
        "explanation_en": "G is usually /ɡ/ (go, gift). Before e, i or y it is /dʒ/ (giraffe, gym). Exceptions like give and get are learned by practice.",
        "examples": [
          "gift /ɡ/",
          "gym /dʒ/",
          "give /ɡ/ (exception)"
        ]
      },
      {
        "title": "E and I sounds",
        "explanation_ar": "e: /e/ (bed) أو /iː/ مثل اسمه (email, he). i: /ɪ/ (insect) أو /aɪ/ (idea, ice) أو /iː/ (police, machine).",
        "explanation_en": "E: /e/ (bed) or /iː/ (email). I: /ɪ/ (insect), /aɪ/ (idea), or /iː/ (police).",
        "examples": [
          "bed, email",
          "insect, idea, police"
