    "fine_lines": [
      {
        "title": "s as /s/ vs s as /z/",
        "words": [
          "sell",
          "was"
        ],
        "explanation_ar": "الحرف s ينطق غالباً /s/ (sell, sun)، لكنه كثيراً ينطق /z/ خاصة بين حرفين متحركين أو في آخر بعض الكلمات (was, rose, is).",
        "explanation_en": "S usually sounds /s/ (sell), but often /z/, especially between vowels or at the end of some words (was, rose, is).",
        "examples": [
          {
            "word": "sell",
            "sentence": "They sell fruit."
          },
          {
            "word": "was",
            "sentence": "He was late."
          }
        ]
      },
      {
        "title": "hard c/g vs soft c/g",
        "words": [
          "cake",
          "city",
          "go",
          "gym"
        ],
        "explanation_ar": "c و g قبل e أو i أو y تصبحان «لينتين»: c = /s/ (city) و g = /dʒ/ (gym). وفي غير ذلك c = /k/ و g = /ɡ/. توجد استثناءات مثل give و get.",
        "explanation_en": "Before e, i or y, c and g are soft: c = /s/ (city), g = /dʒ/ (gym). Otherwise c = /k/ and g = /ɡ/. Exceptions: give, get.",
        "examples": [
          {
            "word": "cake",
            "sentence": "I made a cake."
          },
          {
            "word": "city",
            "sentence": "I live in a city."
          },
          {
            "word": "go",
            "sentence": "Let's go."
          },
          {
            "word": "gym",
            "sentence": "I go to the gym."
          }
        ]
      },
      {
        "title": "p vs b",
        "words": [
          "p",
          "b"
        ],
        "explanation_ar": "الفرق في الهواء: p نجمع الهواء ونطلقه بقوة (الورقة أمام الفم تتحرك)، و b بدون هواء.",
        "explanation_en": "The difference is air: p has a strong puff (a paper in front of your mouth moves); b has none.",
        "examples": [
          {
            "word": "p",
            "sentence": "paper, pen"
          },
          {
            "word": "b",
            "sentence": "boy, ball"
          }
        ]
      },
      {
        "title": "a in bad vs e in bed",
        "words": [
          "bad",
          "bed"
        ],
        "explanation_ar": "a في bad تُنطق /æ/ والفم مفتوح أكثر (بين الفتحة والكسرة)، و e في bed تُنطق /e/ والفم أقل انفتاحاً.",
        "explanation_en": "A in \"bad\" is /æ/ with the mouth more open. E in \"bed\" is /e/ with the mouth less open.",
        "examples": [
          {
            "word": "bad",
            "sentence": "The weather is bad."
          },
          {
            "word": "bed",
            "sentence": "Go to bed early."
          }
        ]
      },
      {
        "title": "i: /ɪ/ vs /aɪ/ vs /iː/",
        "words": [
          "insect",
          "idea",
          "police"
        ],
        "explanation_ar": "للحرف i ثلاثة أصوات شائعة: قصير /ɪ/ (insect)، ومثل اسمه /aɪ/ (idea, ice)، وطويل /iː/ (police, machine).",
        "explanation_en": "I has three common sounds: short /ɪ/ (insect), /aɪ/ like its name (idea), long /iː/ (police).",
        "examples": [
          {
            "word": "insect",
            "sentence": "An ant is an insect."
          },
          {
            "word": "idea",
            "sentence": "Good idea!"
          },
          {
            "word": "police",
            "sentence": "Call the police."
          }
        ]
      }
    ],
