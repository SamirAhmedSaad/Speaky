    "fine_lines": [
      {
        "title": "big vs large",
        "words": [
          "big",
          "large"
        ],
        "explanation_ar": "الكلمتان بمعنى كبير. big أكثر استخداماً في الكلام اليومي، و large أكثر رسمية وتُستخدم كثيراً للمقاسات (size large).",
        "explanation_en": "Both mean not small. \"Big\" is more common in everyday speech; \"large\" is more formal and used for sizes.",
        "examples": [
          {
            "word": "big",
            "sentence": "He lives in a big house."
          },
          {
            "word": "large",
            "sentence": "Can I have a large coffee?"
          }
        ]
      },
      {
        "title": "small vs little",
        "words": [
          "small",
          "little"
        ],
        "explanation_ar": "small تصف الحجم فقط. little تصف الحجم مع إحساس بالعاطفة (a little girl)، وa little تعني «قليل من» مع غير المعدود.",
        "explanation_en": "\"Small\" is about size. \"Little\" can show feeling (a little girl), and \"a little\" means a small amount.",
        "examples": [
          {
            "word": "small",
            "sentence": "This room is small."
          },
          {
            "word": "little",
            "sentence": "She cooked a little food."
          }
        ]
      },
      {
        "title": "good vs well",
        "words": [
          "good",
          "well"
        ],
        "explanation_ar": "good صفة تصف الاسم (a good student)، و well ظرف يصف الفعل (study well). لكن well صفة أيضاً بمعنى «بصحة جيدة».",
        "explanation_en": "\"Good\" is an adjective for nouns. \"Well\" is an adverb for verbs, but also an adjective meaning healthy.",
        "examples": [
          {
            "word": "good",
            "sentence": "He is a good student."
          },
          {
            "word": "well",
            "sentence": "You have to study well."
          }
        ]
      },
      {
        "title": "sure vs certain",
        "words": [
          "sure",
          "certain"
        ],
        "explanation_ar": "الكلمتان بمعنى متأكد، و certain أكثر رسمية قليلاً.",
        "explanation_en": "Both mean you have no doubt. \"Certain\" is a little more formal.",
        "examples": [
          {
            "word": "sure",
            "sentence": "I'm sure he will come."
          },
          {
            "word": "certain",
            "sentence": "It's certain that they will agree."
          }
        ]
      },
      {
        "title": "private vs own",
        "words": [
          "private",
          "own"
        ],
        "explanation_ar": "private تعني خاص (ليس للعامة)، و own تعني ملكك أنت وتأتي بعد my/your.",
        "explanation_en": "\"Private\" means not public. \"Own\" means it belongs to you and comes after my/your.",
        "examples": [
          {
            "word": "private",
            "sentence": "This is a private beach."
          },
          {
            "word": "own",
            "sentence": "She has her own car."
          }
        ]
      }
    ],
