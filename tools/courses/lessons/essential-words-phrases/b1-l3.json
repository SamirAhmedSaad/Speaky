    "fine_lines": [
      {
        "title": "than vs then",
        "words": [
          "than",
          "then"
        ],
        "explanation_ar": "than للمقارنة (أطول من)، و then بمعنى «ثم» أو «بعد ذلك».",
        "explanation_en": "\"Than\" is for comparing. \"Then\" means \"after that\".",
        "examples": [
          {
            "word": "than",
            "sentence": "Zain is taller than Adam."
          },
          {
            "word": "then",
            "sentence": "Let me finish, then we'll go."
          }
        ]
      },
      {
        "title": "some vs any",
        "words": [
          "some",
          "any"
        ],
        "explanation_ar": "some في الجمل المثبتة، و any في الأسئلة والنفي.",
        "explanation_en": "Use \"some\" in positive sentences and \"any\" in questions and negatives.",
        "examples": [
          {
            "word": "some",
            "sentence": "I ordered some food."
          },
          {
            "word": "any",
            "sentence": "Do you have any questions?"
          }
        ]
      },
      {
        "title": "too vs also",
        "words": [
          "too",
          "also"
        ],
        "explanation_ar": "الاثنان بمعنى «أيضاً»، لكن too تأتي في آخر الجملة و also تأتي قبل الفعل الأساسي.",
        "explanation_en": "Both mean \"in addition\". \"Too\" goes at the end; \"also\" goes before the main verb.",
        "examples": [
          {
            "word": "too",
            "sentence": "I'm hungry too."
          },
          {
            "word": "also",
            "sentence": "I also like tea."
          }
        ]
      },
      {
        "title": "many vs much vs a lot of",
        "words": [
          "many",
          "much",
          "a lot of"
        ],
        "explanation_ar": "many مع الأسماء المعدودة (many toys)، و much مع غير المعدودة (much money) غالباً في النفي والسؤال، و a lot of مع النوعين.",
        "explanation_en": "\"Many\" for countable nouns, \"much\" for uncountable nouns (mostly in questions and negatives), \"a lot of\" for both.",
        "examples": [
          {
            "word": "many",
            "sentence": "My son has many toys."
          },
          {
            "word": "much",
            "sentence": "I don't have much time."
          },
          {
            "word": "a lot of",
            "sentence": "He makes a lot of money."
          }
        ]
      },
      {
        "title": "other vs another",
        "words": [
          "other",
          "another"
        ],
        "explanation_ar": "another = واحد آخر (مفرد وغير محدد)، و the other = الآخر المحدد من اثنين، و other مع الجمع.",
        "explanation_en": "\"Another\" means one more (singular). \"The other\" is the second of two. \"Other\" is used with plurals.",
        "examples": [
          {
            "word": "another",
            "sentence": "Can I have another one?"
          },
          {
            "word": "other",
            "sentence": "Where is the other book?"
          }
        ]
      }
