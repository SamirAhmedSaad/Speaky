    "fine_lines": [
      {
        "title": "How old are you? vs How are you?",
        "words": [
          "How old are you?",
          "How are you?"
        ],
        "explanation_ar": "How old are you? سؤال عن العمر، والجواب رقم: I'm seven. أما How are you? فسؤال عن الحال، والجواب: I'm fine.",
        "explanation_en": "\"How old are you?\" asks about age. Answer with a number: I'm seven. \"How are you?\" asks how you feel. Answer: I'm fine.",
        "examples": [
          {
            "word": "How old are you?",
            "sentence": "How old are you? - I'm seven."
          },
          {
            "word": "How are you?",
            "sentence": "How are you? - I'm fine, thank you."
          }
        ]
      }
    ],
