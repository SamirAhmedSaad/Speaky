        "note_ar": "",
        "note_en": "",
        "example": "What's that on the tree?"
      },
      {
        "word": "it",
        "pos": "pronoun",
        "meaning_en": "a thing or an animal (not a person)",
        "meaning_ar": "هو / هي (لغير العاقل)",
        "note_ar": "",
        "note_en": "",
        "example": "It's a cat."
