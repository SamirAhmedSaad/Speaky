        "note_en": "",
        "example": "Thank you for the book."
      }
    ],
    "fine_lines": [
      {
        "title": "this vs that",
        "words": [
          "this",
          "that"
        ],
        "explanation_ar": "this للشيء القريب منك، و that للشيء البعيد عنك.",
        "explanation_en": "\"this\" is for a thing near you. \"that\" is for a thing far from you.",
        "examples": [
          {
            "word": "this",
            "sentence": "This is my bag."
          },
          {
            "word": "that",
            "sentence": "What's that in the sky?"
          }
        ]
      },
      {
        "title": "a + noun",
        "words": [
          "a cat",
          "a dog"
        ],
        "explanation_ar": "نضع a قبل الاسم المفرد عندما نذكره أول مرة: a cat, a dog, a bird.",
        "explanation_en": "Put \"a\" before one thing: a cat, a dog, a bird.",
        "examples": [
          {
            "word": "a cat",
            "sentence": "It's a cat."
          },
          {
            "word": "a dog",
            "sentence": "It's a dog."
          }
        ]
      }
    ],
    "expressions": [
      {
        "phrase": "What's that?",
        "meaning_ar": "ما ذلك؟",
        "meaning_en": "What is that thing?",
        "example": "What's that? - It's a bird."
      },
      {
        "phrase": "It's a cat.",
        "meaning_ar": "إنها قطة.",
        "meaning_en": "That thing is a cat.",
        "example": "What's that? - It's a cat."
      },
      {
        "phrase": "It's for you.",
        "meaning_ar": "إنه لك.",
        "meaning_en": "I am giving it to you.",
        "example": "Here is a book. It's for you."
      },
      {
        "phrase": "Thank you.",
        "meaning_ar": "شكرًا لك.",
        "meaning_en": "Polite words when you get something.",
        "example": "It's for you. - Thank you."
      }
    ],
    "grammar": [
      {
        "title": "What's that? - It's a ...",
        "explanation_ar": "What's = What is. نسأل What's that? عن شيء بعيد، ونجيب It's a + اسم الشيء. It's = It is.",
        "explanation_en": "What's = What is. Ask \"What's that?\" Answer \"It's a ...\" (It's = It is).",
        "examples": [
          "What's that? - It's a bird.",
          "What's that? - It's a dog.",
          "It's a cat."
        ]
      }
    ]
  },
  "questions": [
