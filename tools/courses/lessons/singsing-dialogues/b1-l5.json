    "fine_lines": [
      {
        "title": "Who vs What",
        "words": [
          "who",
          "what"
        ],
        "explanation_ar": "نستخدم who للسؤال عن الأشخاص، و what للسؤال عن الأشياء.",
        "explanation_en": "Use \"who\" for people and \"what\" for things.",
        "examples": [
          {
            "word": "who",
            "sentence": "Who is this? - It's my grandpa."
          },
          {
            "word": "what",
            "sentence": "What's that? - It's my bike."
          }
        ]
      },
      {
        "title": "grandpa vs grandma",
        "words": [
          "grandpa",
          "grandma"
        ],
        "explanation_ar": "grandpa الجد (رجل)، و grandma الجدة (امرأة). الكلمتان الرسميتان: grandfather و grandmother.",
        "explanation_en": "grandpa is a man; grandma is a woman. Formal words: grandfather, grandmother.",
        "examples": [
          {
            "word": "grandpa",
            "sentence": "My grandpa is old and kind."
          },
          {
            "word": "grandma",
            "sentence": "My grandma makes good bread."
          }
        ]
      }
    ],
    "expressions": [
