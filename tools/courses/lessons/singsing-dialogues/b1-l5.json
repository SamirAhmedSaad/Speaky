    "grammar": [
      {
        "title": "Asking about people: Who is this?",
        "explanation_ar": "نسأل عن شخص بـ Who is this? ونجيب It's my + فرد من العائلة، أو This is my + ... .",
        "explanation_en": "Ask \"Who is this?\" Answer: It's my sister. / It's my grandpa.",
        "examples": [
          "Who is this? - It's my sister.",
          "Who is this? - It's my grandma.",
          "Who is this, Toto? - It's my grandpa."
        ]
      }
