    "explanation_en": "\"It's raining\" means rain is falling now. \"Rainy\" describes a day or place.",
    "examples": [
     {
      "word": "It's raining",
      "sentence": "Take an umbrella. It's raining."
     },
     {
      "word": "It's rainy",
      "sentence": "It's a rainy day."
     }
    ]
   },
