  "grammar": [
   {
    "title": "It's + weather adjective",
    "explanation_ar": "في الإنجليزية نستخدم it للحديث عن الطقس: It's hot. It's sunny. It's cloudy. لا نحذف it كما في العربية «الجو حار».",
    "explanation_en": "Use \"it\" to talk about the weather: It's hot. It's cloudy. Don't leave out \"it\".",
    "examples": [
     "It's hot and sunny.",
     "It's windy and cold.",
     "It's cloudy."
    ]
   },
   {
    "title": "It's raining / It's snowing (present continuous)",
    "explanation_ar": "rain و snow أفعال، فنستخدم المضارع المستمر لما يحدث الآن: It's raining. It's snowing. والنفي: It's not raining.",
    "explanation_en": "\"Rain\" and \"snow\" are verbs. Use the present continuous for now: It's raining.",
    "examples": [
     "It's raining.",
     "It's snowing.",
     "It's not raining."
    ]
   }
  ]
 },
