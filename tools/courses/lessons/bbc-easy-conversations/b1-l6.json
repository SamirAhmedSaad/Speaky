  "grammar": [
   {
    "title": "Present continuous: am/is/are + verb-ing",
    "explanation_ar": "نستخدم المضارع المستمر لما يحدث الآن: I am (I'm) + فعل-ing، he/she is + فعل-ing، you/we/they are + فعل-ing.",
    "explanation_en": "Use the present continuous for actions happening now: am/is/are + verb-ing.",
    "examples": [
     "I'm cooking.",
     "He's reading a book.",
     "They're watching TV."
    ]
   },
   {
    "title": "Spelling of -ing",
    "explanation_ar": "معظم الأفعال نضيف لها ing مباشرة (read → reading). إذا انتهى الفعل بـ e صامتة نحذفها (exercise → exercising). بعض الأفعال القصيرة نضاعف آخر حرف (swim → swimming).",
    "explanation_en": "Most verbs: add -ing. Silent e: drop it (exercising). Some short verbs double the last letter (swimming).",
    "examples": [
     "read → reading",
     "cook → cooking",
     "exercise → exercising",
     "swim → swimming"
    ]
   },
   {
    "title": "Questions: What are you doing?",
    "explanation_ar": "للسؤال نضع am/is/are قبل الفاعل: What are you doing? What is Tim doing? What's he doing?",
    "explanation_en": "To ask, put am/is/are before the subject.",
    "examples": [
     "What are you doing?",
     "What is she doing?",
     "Are you studying?"
    ]
   }
  ]
 },
