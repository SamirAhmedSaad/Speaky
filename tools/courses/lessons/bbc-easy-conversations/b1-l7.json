  "fine_lines": [
   {
    "title": "like / love / hate",
    "words": [
     "like",
     "love",
     "hate"
    ],
    "explanation_ar": "love أقوى من like، و hate أقوى من don't like. ترتيبها: love > like > don't like > hate.",
    "explanation_en": "\"Love\" is stronger than \"like\"; \"hate\" is stronger than \"don't like\".",
    "examples": [
     {
      "word": "love",
      "sentence": "I love chocolate."
     },
     {
      "word": "like",
      "sentence": "I like fish."
     },
     {
      "word": "hate",
      "sentence": "I hate jelly."
     }
    ]
   },
   {
    "title": "like / would like",
    "words": [
     "like",
     "would like"
    ],
    "explanation_ar": "like تعني تحب شيئًا بشكل عام، أما would like (I'd like) فتعني تريده الآن بأدب.",
    "explanation_en": "\"I like\" is about things you enjoy in general. \"I'd like\" means \"I want\" (polite).",
    "examples": [
     {
      "word": "like",
      "sentence": "I like fruit."
     },
     {
      "word": "would like",
      "sentence": "I'd like an apple, please."
     }
    ]
   }
  ],
  "expressions": [
   {
    "phrase": "What do you like?",
    "meaning_ar": "ماذا تحب؟",
    "meaning_en": "ask about someone's likes",
    "example": "What do you like? - I like fish."
   },
   {
    "phrase": "I like fish.",
    "meaning_ar": "أحب السمك.",
    "meaning_en": "say something you like",
    "example": "I like fish and rice."
   },
   {
    "phrase": "I like fruit and chocolate.",
    "meaning_ar": "أحب الفاكهة والشوكولاتة.",
    "meaning_en": "say two things you like",
    "example": "I like tea and cake."
   },
   {
    "phrase": "What food don't you like?",
    "meaning_ar": "ما الطعام الذي لا تحبه؟",
    "meaning_en": "ask about dislikes",
    "example": "What food don't you like? - I don't like nuts."
   },
   {
    "phrase": "I don't like nuts.",
    "meaning_ar": "لا أحب المكسرات.",
    "meaning_en": "say something you don't like",
    "example": "I don't like nuts or eggs."
   },
   {
    "phrase": "Do you like cheese?",
    "meaning_ar": "هل تحب الجبن؟",
    "meaning_en": "a yes/no question about likes",
    "example": "Do you like cheese? - Yes, I do."
   },
   {
    "phrase": "Yes, I do. / No, I don't.",
    "meaning_ar": "نعم، أحبه. / لا، لا أحبه.",
    "meaning_en": "short answers",
    "example": "Do you like jelly? - No, I don't."
   }
  ],
  "grammar": [
   {
    "title": "Like / don't like + noun",
    "explanation_ar": "نقول I like + اسم للتعبير عن الحب، و I don't like + اسم للنفي. don't = do not. مع he/she: He likes / She doesn't like.",
    "explanation_en": "Say \"I like ...\" and \"I don't like ...\". With he/she: likes / doesn't like.",
    "examples": [
     "I like fish.",
     "I don't like nuts.",
     "She likes chocolate, but she doesn't like jelly."
    ]
   },
   {
    "title": "Questions with do: Do you like ...? / What do you like?",
    "explanation_ar": "للسؤال نستخدم do: Do you like fish? والجواب: Yes, I do. / No, I don't. ولسؤال مفتوح: What food don't you like?",
    "explanation_en": "Ask with \"do\": Do you like ...? Answer: Yes, I do / No, I don't.",
    "examples": [
     "Do you like fruit? - Yes, I do.",
     "What do you like?",
     "What food don't you like?"
    ]
   }
  ]
 },
