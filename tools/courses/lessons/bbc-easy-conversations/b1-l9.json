  "fine_lines": [
   {
    "title": "can / can't",
    "words": [
     "can",
     "can't"
    ],
    "explanation_ar": "can للقدرة و can't (cannot) لعدم القدرة. في الكلام can ضعيفة النطق /kən/ أما can't فقوية وواضحة، فاستمع للفرق.",
    "explanation_en": "\"Can\" = able; \"can't\" = not able. In speech \"can\" is weak and \"can't\" is strong.",
    "examples": [
     {
      "word": "can",
      "sentence": "I can swim."
     },
     {
      "word": "can't",
      "sentence": "I can't juggle."
     }
    ]
   },
   {
    "title": "well / good",
    "words": [
     "well",
     "good"
    ],
    "explanation_ar": "well ظرف يأتي بعد الفعل ليصف كيف نفعل الشيء: She can cook well. أما good فصفة تأتي قبل الاسم أو بعد be: She is a good cook. لا نقول She can cook good.",
    "explanation_en": "\"Well\" is an adverb; it goes after a verb: She can cook well. \"Good\" is an adjective; it goes before a noun or after \"be\": She's a good cook. Don't say \"She can cook good.\"",
    "examples": [
     {
      "word": "well",
      "sentence": "He can swim very well."
     },
     {
      "word": "good",
      "sentence": "He is a good swimmer."
     }
    ]
   }
  ],
