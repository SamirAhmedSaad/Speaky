   {
    "title": "light / heavy, cheap / expensive",
    "words": [
     "light",
     "heavy",
     "cheap",
     "expensive"
    ],
    "explanation_ar": "هذه أزواج متضادة: light ضد heavy (الوزن)، و cheap ضد expensive (السعر). كذلك big ضد small، و new ضد old.",
    "explanation_en": "These are opposites: light ≠ heavy (weight), cheap ≠ expensive (price), big ≠ small, new ≠ old.",
    "examples": [
     {
      "word": "light",
      "sentence": "The bag is light."
     },
     {
      "word": "heavy",
      "sentence": "The box is heavy."
     },
     {
      "word": "cheap",
      "sentence": "The pen is cheap."
     },
     {
      "word": "expensive",
      "sentence": "The watch is expensive."
     }
    ]
   },
   {
    "title": "old (thing) / old (person)",
    "words": [
     "old",
     "new",
     "young"
    ],
    "explanation_ar": "عكس old للأشياء هو new، أما للأشخاص فعكسها young.",
    "explanation_en": "For things, the opposite of \"old\" is \"new\". For people, it is \"young\".",
    "examples": [
     {
      "word": "new",
      "sentence": "It's a new car."
     },
     {
      "word": "young",
      "sentence": "He's a young man."
     }
    ]
   }
